{
  "name": "template-nest-nuxt-docker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11",
    "npm": "please-use-pnpm"
  },
  "description": "",
  "scripts": {
    "env:copy": "node scripts/copy-env-cli.mjs",
