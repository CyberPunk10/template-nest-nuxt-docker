# Хост-порты — на чём сервис доступен снаружи Docker.
# Значения разнесены по сотням начиная с 3500 (не 3500/3600/3700).
BACKEND_HOST_PORT=3500
FRONTEND_HOST_PORT=3600
DOCS_HOST_PORT=3700

# Порт, на котором процесс слушает ВНУТРИ контейнера. docker-compose.yml сам
# передаёт это значение и в правую часть маппинга портов, и в PORT внутри
# контейнера (переопределяя то, что лежит в apps/*/.env) — оба места
# гарантированно совпадают, менять их по отдельности не нужно.
BACKEND_INTERNAL_PORT=3100
FRONTEND_INTERNAL_PORT=3200
DOCS_INTERNAL_PORT=3300
