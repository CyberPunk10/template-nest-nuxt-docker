NUXT_PUBLIC_APP_ENV=development
NUXT_PUBLIC_API_BASE=/api/backend

# Follows the backend's PORT (apps/backend/.env).
# Docker overrides it with the service name — see docker-compose.yml.
NUXT_BACKEND_URL=http://localhost:3100

# Follows the docs' PORT (apps/docs/.env).
# The /dev/docs/ path is required — it's the docs' base.
NUXT_PUBLIC_DOCS_URL=http://localhost:5173/dev/docs/

# Referenced by CORS_ORIGIN (apps/backend/.env)
PORT=3200
