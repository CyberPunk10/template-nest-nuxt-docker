NODE_ENV=development
APP_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=template

# Rate limiting (на каждый IP)
THROTTLE_TTL=60000        # окно в мс (1 минута)
THROTTLE_LIMIT=100        # максимум запросов за окно (глобально)

# JWT access token
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=15m

# Refresh token (хранится в БД как HMAC-хэш)
REFRESH_TOKEN_SECRET=change-me-to-another-random-string-of-at-least-32-characters
REFRESH_TOKEN_EXPIRES_DAYS=7

# Bcrypt (стоимость хеширования: 4–20, рекомендуется ≥12 в проде, можно снизить до 4 в тестах)
BCRYPT_ROUNDS=12
