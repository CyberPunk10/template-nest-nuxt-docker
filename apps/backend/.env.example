NODE_ENV=development
APP_ENV=development

# Empty = auto: on everywhere except production.
SWAGGER_ENABLED=

# Referenced by NUXT_BACKEND_URL (apps/frontend/.env)
PORT=3100

# Must match the frontend's PORT (apps/frontend/.env).
# Docker overrides it with the proxy address — see docker-compose.yml.
CORS_ORIGIN=http://localhost:3200
